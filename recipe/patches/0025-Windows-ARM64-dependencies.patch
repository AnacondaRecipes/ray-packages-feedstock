diff --git a/thirdparty/patches/rules_boost-lzma-arm64.patch b/thirdparty/patches/rules_boost-lzma-arm64.patch
new file mode 100644
index 0000000..b73efe0
--- /dev/null
+++ b/thirdparty/patches/rules_boost-lzma-arm64.patch
@@ -0,0 +1,13 @@
+diff --git a/config.lzma-windows.h b/config.lzma-windows.h
+--- a/config.lzma-windows.h
++++ b/config.lzma-windows.h
+@@ -157,2 +157,4 @@
+ /* Define to 1 if you have the <immintrin.h> header file. */
++#if (defined(_M_IX86) || defined(_M_X64) || defined(__i386__) || defined(__x86_64__)) && !defined(_M_ARM64EC)
+ #define HAVE_IMMINTRIN_H 1
++#endif
+@@ -296,2 +298,4 @@
+ /* Define to 1 if _mm_movemask_epi8 is available. */
++#if (defined(_M_IX86) || defined(_M_X64) || defined(__i386__) || defined(__x86_64__)) && !defined(_M_ARM64EC)
+ #define HAVE__MM_MOVEMASK_EPI8 1
++#endif
