From: Eric Lundby <elundby@anaconda.com>
Date: Thu, 30 Oct 2026 22:20:00 +0000
Subject: [PATCH] Support Bazel 8.8.2

---
diff --git a/.bazelrc b/.bazelrc
index b0caccc..a0bdb1e 100644
--- a/.bazelrc
+++ b/.bazelrc
@@ -1,4 +1,7 @@
 common --noenable_bzlmod
+common --enable_workspace
+common --noincompatible_disallow_empty_glob
+common --noincompatible_disallow_ctx_resolve_tools
 
 # Must be first. Enables build:windows, build:linux, build:macos, build:freebsd, build:openbsd
 build --enable_platform_specific_config
@@ -50,6 +53,8 @@ build:clang-cl --cxxopt="-std=c++17"
 build:msvc-cl --cxxopt="/std:c++17"
 build:windows --cxxopt="/std:c++17"
 build:windows --cxxopt="/utf-8"
+build --cxxopt="-DPROTOBUF_FUTURE_REMOVE_CREATEMESSAGE"
+build --host_cxxopt="-DPROTOBUF_FUTURE_REMOVE_CREATEMESSAGE"
 # This workaround is needed to prevent Bazel from compiling the same file twice (once PIC and once not).
 build:linux --copt="-fPIC"
 build:macos --copt="-fPIC"
@@ -264,7 +269,8 @@ build:ubsan --copt -fno-sanitize-recover=all
 build:ubsan --copt -g
 build:ubsan --linkopt -fsanitize=undefined
 build:ubsan --linkopt -fno-sanitize-recover=all
-build:ubsan --per_file_copt="-external/com_github_grpc_grpc/.*@-fsanitize=undefined"
+build:ubsan --per_file_copt="-external/com_github_grpc_grpc/.*@-fsanitize=undefined,-fno-sanitize=null,-fno-sanitize=nonnull-attribute,-fno-sanitize=returns-nonnull-attribute"
+build:ubsan --copt -Wno-error=maybe-uninitialized
 
 build:cgroup --sandbox_writable_path=/sys/fs/cgroup --config=llvm
 
@@ -300,3 +306,4 @@ build:macos --host_copt=-mmacosx-version-min=12.0
 build:macos --host_linkopt=-mmacosx-version-min=12.0
 # This option controls whether javac checks for missing direct dependencies.
 build --experimental_strict_java_deps=off
+build --java_language_version=8
